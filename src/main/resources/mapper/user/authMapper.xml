<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.badminton.mintup.dao.AuthDao">
    <select id="findByUserId" resultType="com.badminton.mintup.vo.UserVo$UserInfoVo">
        select
            email
            , password
        from mintup.tbl_mu_user
        where email = #{email}
    </select>
</mapper>